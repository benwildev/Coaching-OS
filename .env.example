# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coaching_os?schema=public"

# Auth Session Secret — REQUIRED. There is no default/fallback: the app
# refuses to authenticate anyone if this is missing or under 32 characters.
# Generate a real random value per environment, e.g.: openssl rand -hex 32
# Never reuse this placeholder, and never commit the real value.
AUTH_SECRET="replace-with-a-random-32+-character-secret-per-environment"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary — file uploads (logos, student/teacher photos, study materials).
# Get these from https://console.cloudinary.com/settings/api-keys
# Never commit the real values.
CLOUDINARY_CLOUD_NAME="replace-with-your-cloud-name"
CLOUDINARY_API_KEY="replace-with-your-api-key"
CLOUDINARY_API_SECRET="replace-with-your-api-secret"

# ---------------------------------------------------------------------------
# Phase 10.8 — Communication providers. Every channel stays honestly
# "Not configured" (never fakes delivery) until it's configured — either via
# the env vars below, or per-tenant from the Communication Settings UI
# (Owner/Admin), which takes precedence when set. See docs/communication.md
# for full setup instructions.
# ---------------------------------------------------------------------------

# REQUIRED once any tenant saves provider credentials via the Communication
# Settings UI — encrypts them at rest (AES-256-GCM). No default/fallback,
# same as AUTH_SECRET. Generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-random-32+-character-secret-per-environment"

# SMS — SMS.BD (https://sms.bd/), Alpha-SMS-style REST API.
# CAVEAT: verify this contract against your own SMS.BD account dashboard
# docs before your first real send — it was taken from public API docs, not
# a live account.
SMS_PROVIDER_API_KEY="replace-with-your-sms.bd-api-key"
SMS_SENDER_ID="replace-with-your-approved-sender-id"
SMS_PROVIDER_BASE_URL="https://api.sms.net.bd"

# WhatsApp — official WhatsApp Business Cloud API (Meta Graph API). Never
# browser automation over a personal WhatsApp session.
WHATSAPP_BUSINESS_API_TOKEN="replace-with-your-whatsapp-cloud-api-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-your-whatsapp-phone-number-id"
WHATSAPP_API_VERSION="v20.0"
# Used to verify X-Hub-Signature-256 on incoming delivery-status webhooks.
WHATSAPP_APP_SECRET="replace-with-your-meta-app-secret"
# Any string you choose — must match what you enter in Meta's webhook setup.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"

# Email — Gmail SMTP via nodemailer. EMAIL_SMTP_PASS must be a Gmail App
# Password (https://myaccount.google.com/apppasswords), never the account's
# normal login password.
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER="replace-with-your-gmail-address"
EMAIL_SMTP_PASS="replace-with-your-gmail-app-password"
EMAIL_FROM_NAME="Coaching Center"

# Shared secret for the scheduled retry sweep (POST /api/communication/retry/
# process-due), called by an external scheduler (e.g. Vercel Cron) rather
# than a logged-in user. Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret-per-environment"

# TEST ONLY. When set to "1", all communication providers simulate their
# result deterministically instead of making any real network call — used by
# scripts/verify-phase10-8.ts. NEVER set this in a production environment.
COMMUNICATION_MOCK_MODE=""

# ---------------------------------------------------------------------------
# scripts/verify-phase*.ts (dev/test only — not read by the running app).
# Points the HTTP-driven verification scripts at a running dev server.
# ---------------------------------------------------------------------------
AUTH_BASE_URL="http://localhost:3000"
RESULT_AUTH_BASE_URL="http://localhost:3000"
