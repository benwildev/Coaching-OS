  entity           String         // e.g. "CoachingCenter", "User", "AcademicProgram"
  entityId         String?
  details          Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime       @default(now())

  coachingCenter   CoachingCenter @relation(fields: [coachingCenterId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([coachingCenterId, action])
  @@index([coachingCenterId, createdAt])
  @@map("audit_logs")
}

model Media {
  id               String         @id @default(uuid())
  coachingCenterId String
  filename         String
  originalName     String
  mimeType         String
  size             Int
  url              String
  path             String
  uploaderId       String?
  createdAt        DateTime       @default(now())

  coachingCenter   CoachingCenter @relation(fields: [coachingCenterId], references: [id], onDelete: Cascade)
  uploader         User?          @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@map("media")
}

// ==========================================
// SAAS SUBSCRIPTIONS
// ==========================================

model SubscriptionPlan {
  id            String         @id @default(uuid())
